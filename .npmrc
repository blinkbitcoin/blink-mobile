# The @blinkbitcoin scope resolves from GitHub Packages, not the public registry:
# that is where blink-esign publishes. Reads need auth, so add the token to your
# own ~/.npmrc (a classic PAT with read:packages), never here:
#   //npm.pkg.github.com/:_authToken=<token>
# Kept out of this file on purpose: yarn 1 aborts every install, not just this
# scope, when an ${ENV_VAR} it finds here is unset.
#
# blink-client and react-native-geetest-module share the scope but live on the
# public registry; the lockfile keeps them resolving from there. To bump either,
# pass --registry https://registry.yarnpkg.com to yarn add.
@blinkbitcoin:registry=https://npm.pkg.github.com
